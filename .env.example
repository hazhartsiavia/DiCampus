# E-mails des administrateurs (séparés par des virgules) : ils valident les demandes enseignant.
DICAMPUS_ADMIN_EMAILS=admin@exemple.mg

# Emplacement de la base SQLite. En production, un dossier hors du dossier déployé,
# pour que les comptes, notes et copies survivent aux redéploiements.
# DICAMPUS_DB_PATH=/home/utilisateur/dicampus-data/dicampus.db
